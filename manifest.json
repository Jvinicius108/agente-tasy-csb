{
  "manifest_version": 3,
  "name": "Agente Tasy - CSB",
  "version": "40.3",
  "description": "Agente de faturamento automático para o Tasy CSB",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://tasy.grupocsb.com/*"],
  "content_scripts": [
    {
      "matches": ["https://tasy.grupocsb.com/*"],
      "js": ["jspdf.umd.min.js", "agente-bundle.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Agente Tasy CSB"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
